rules_version = '2';
// Tasuki Cards. Everyone with a @harrowappi.jp Microsoft sign-in (the school's own tenant) can read the
// view-only copy. The full data needs that sign-in AND the head coach's account or a place on his coach list.
service cloud.firestore {
  match /databases/{database}/documents {
    function school() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'microsoft.com'
        && request.auth.token.email.lower().matches('^[^@]+@harrowappi[.]jp$');
    }
    // Anyone signed in through Microsoft. The Microsoft app is registered for the school's directory only
    // ("My organization only"), so Microsoft itself refuses accounts from anywhere else. This does not depend
    // on the email claim, which pupils' accounts may not carry.
    function member() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'microsoft.com';
    }
    function owner() {
      return school() && request.auth.token.email.lower() == 'floke@harrowappi.jp';
    }
    function coach() {
      return owner()
        || (school() && exists(/databases/$(database)/documents/access/main)
            && request.auth.token.email.lower() in get(/databases/$(database)/documents/access/main).data.coaches);
    }
    match /access/main {
      allow read: if coach();
      allow write: if owner()
        && request.resource.data.keys().hasOnly(['coaches', 'pupilView'])
        && request.resource.data.coaches is list;
    }
    match /squad/{doc} {
      allow read, write: if coach();
    }
    // The view-only copy (no dates of birth, notes or hidden names): everyone at school can read it,
    // only coaches can write it.
    // The head coach can close the pupil view at any time (access/main.pupilView = false).
    function pupilViewOpen() {
      return !exists(/databases/$(database)/documents/access/main)
        || get(/databases/$(database)/documents/access/main).data.get('pupilView', true) == true;
    }
    match /public/{doc} {
      allow read: if member() && (pupilViewOpen() || coach());
      allow write: if coach() && (doc != 'settings' || owner());
    }
    // Treadmill logs from pupils: anyone at school can send one (while the pupil view is open) for the coach
    // to check. Every field is checked: who sent it must be the signed-in account, the numbers must be in
    // range, and the photo is a small crop of the console. Pupils can see and withdraw only their own;
    // coaches see all and delete each once decided. Nothing can be changed after it is sent.
    function validLog(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'email', 'name', 'athleteId', 'date', 'distanceKm', 'timeSec', 'inclinePct', 'speedKmh', 'effort', 'read', 'edited', 'flags', 'photo', 'at'])
        && d.keys().hasAll(['uid', 'athleteId', 'date', 'distanceKm', 'timeSec', 'read', 'at'])
        && d.uid == request.auth.uid
        && id.matches('^' + request.auth.uid + '_[0-9]{13}$')
        && (!('email' in d) || d.email == request.auth.token.email)
        && (!('name' in d) || d.name == request.auth.token.name)
        && d.athleteId is string && d.athleteId.size() > 0 && d.athleteId.size() <= 64
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.distanceKm is number && d.distanceKm > 0 && d.distanceKm <= 50
        && d.timeSec is number && d.timeSec > 0 && d.timeSec <= 21600
        && (!('inclinePct' in d) || (d.inclinePct is number && d.inclinePct >= 0 && d.inclinePct <= 40))
        && (!('speedKmh' in d) || (d.speedKmh is number && d.speedKmh >= 0 && d.speedKmh <= 40))
        && (!('effort' in d) || (d.effort is int && d.effort >= 1 && d.effort <= 10))
        && d.read in ['photo', 'typed']
        && (!('edited' in d) || d.edited is bool)
        && (!('flags' in d) || (d.flags is list && d.flags.size() <= 8))
        && (!('photo' in d) || (d.photo is bytes && d.photo.size() <= 150000))
        && d.at == request.time;
    }
    // Treadmill logging has its own switch (public/settings.treadmillLogs, set by the head coach). On unless
    // he switches it off.
    function logsOpen() {
      return !exists(/databases/$(database)/documents/public/settings)
        || get(/databases/$(database)/documents/public/settings).data.get('treadmillLogs', true) == true;
    }
    match /inbox/{id} {
      allow create: if member() && pupilViewOpen() && logsOpen() && validLog(id);
      allow read, delete: if coach() || (member() && resource.data.uid == request.auth.uid);
    }
    // Trail reminders (web push to pupils' phones, opt-in): off until the head coach switches them on
    // (public/settings.reminders). One document per phone, id '<uid>_<random device id>', holding only which
    // card it is for, which reminders were chosen, the companion's name, and the phone's push address (only
    // the main push services are accepted). The pupil can read, change and delete their own; nobody else
    // reads them, coaches included. The sender (a scheduled job with the service account) reads them all.
    function remindersOpen() {
      return exists(/databases/$(database)/documents/public/settings)
        && get(/databases/$(database)/documents/public/settings).data.get('reminders', false) == true;
    }
    function validReminder(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'athleteId', 'prefs', 'companion', 'endpoint', 'p256dh', 'auth', 'at'])
        && d.keys().hasAll(['uid', 'athleteId', 'prefs', 'endpoint', 'p256dh', 'auth', 'at'])
        && d.uid == request.auth.uid
        && id.matches('^' + request.auth.uid + '_[a-z0-9]{12,32}$')
        && d.athleteId is string && d.athleteId.size() > 0 && d.athleteId.size() <= 64
        && d.prefs is map && d.prefs.keys().hasOnly(['thursday', 'saturday', 'monday']) && d.prefs.keys().hasAll(['thursday', 'saturday', 'monday'])
        && d.prefs.thursday is bool && d.prefs.saturday is bool && d.prefs.monday is bool
        && (!('companion' in d) || (d.companion is string && d.companion.size() <= 16))
        && d.endpoint is string && d.endpoint.size() <= 1024
        && d.endpoint.matches('^https://(fcm[.]googleapis[.]com|web[.]push[.]apple[.]com|updates[.]push[.]services[.]mozilla[.]com|[a-z0-9-]+[.]notify[.]windows[.]com)/.+')
        && d.p256dh is string && d.p256dh.size() > 0 && d.p256dh.size() <= 200
        && d.auth is string && d.auth.size() > 0 && d.auth.size() <= 64
        && d.at == request.time;
    }
    match /reminders/{id} {
      allow create, update: if member() && pupilViewOpen() && remindersOpen() && validReminder(id);
      allow read, delete: if member() && id.matches('^' + request.auth.uid + '_.+');
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
