rules_version = '2';
// Tasuki Cards. Everyone with a @harrowappi.jp Microsoft sign-in (the school's own tenant) can read the
// view-only copy. The full data needs that sign-in AND the head coach's account or a place on his coach list.
service cloud.firestore {
  match /databases/{database}/documents {
    function school() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'microsoft.com'
        && request.auth.token.email.lower().matches('^[^@]+@harrowappi[.]jp$');
    }
    function owner() {
      return school() && request.auth.token.email.lower() == 'floke@harrowappi.jp';
    }
    function coach() {
      return owner()
        || (school() && request.auth.token.email.lower() in get(/databases/$(database)/documents/access/main).data.coaches);
    }
    match /access/main {
      allow read: if coach();
      allow write: if owner()
        && request.resource.data.keys().hasOnly(['coaches', 'pupilView'])
        && request.resource.data.coaches is list;
    }
    match /squad/{doc} {
      allow read, write: if coach();
    }
    // The view-only copy (no dates of birth, notes or hidden names): everyone at school can read it,
    // only coaches can write it.
    // The head coach can close the pupil view at any time (access/main.pupilView = false).
    function pupilViewOpen() {
      return get(/databases/$(database)/documents/access/main).data.get('pupilView', true) == true;
    }
    match /public/{doc} {
      allow read: if coach() || (school() && pupilViewOpen());
      allow write: if coach();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
