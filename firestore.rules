rules_version = '2';
// Tasuki Cards: staff only. A @harrowappi.jp Microsoft sign-in (through the school's own Microsoft tenant) is necessary but not enough:
// the account must also be the head coach or on the coach list the head coach keeps.
service cloud.firestore {
  match /databases/{database}/documents {
    function school() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'microsoft.com'
        && request.auth.token.email.lower().matches('^[^@]+@harrowappi[.]jp$');
    }
    // Stopgap: the head coach's own Google account (it already owns this Firebase project), by user ID.
    function ownerGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.uid == '__OWNER_GOOGLE_UID__';
    }
    function owner() {
      return ownerGoogle() || (school() && request.auth.token.email.lower() == 'floke@harrowappi.jp');
    }
    function coach() {
      return owner()
        || (school() && request.auth.token.email.lower() in get(/databases/$(database)/documents/access/main).data.coaches);
    }
    match /access/main {
      allow read: if coach();
      allow write: if owner()
        && request.resource.data.keys().hasOnly(['coaches'])
        && request.resource.data.coaches is list;
    }
    match /squad/{doc} {
      allow read, write: if coach();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
