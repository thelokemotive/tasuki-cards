{
  "name": "tasuki-cards",
  "private": true,
  "version": "1.0.0",
  "description": "Tasuki Cards: trading cards and leaderboards for Harrow Appi Trail Running (Stage 1, coach-operated)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "convert-tables": "node scripts/convert-age-tables.mjs ../tasuki-cards-data",
    "check:print": "node scripts/check-print.mjs"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "puppeteer-core": "25.12.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  }
}
